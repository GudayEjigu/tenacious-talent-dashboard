# Copy to .streamlit/secrets.toml and fill in your values.
# Do not commit secrets.toml to git.

# Required — published CSV (File → Share → Publish to web → CSV)
# Must end with /pub?output=csv (not pubhtml or /edit)
sheet_csv_url = "https://docs.google.com/spreadsheets/d/e/2PACX-1vTHOdZugsQlciIwFckKYXqHGn8NBlXdLHJwFf3KxuabSdtXX6rlunWMx7yegMiQK6cSckTTiX6ISsH4/pub?output=csv"

# Optional — Google Sheets API (not used by default app)
# spreadsheet_id = "your_spreadsheet_id_from_url"
# worksheet_name = "Form Responses 1"

# [gcp_service_account]
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "...@....iam.gserviceaccount.com"
# client_id = "..."
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "..."
